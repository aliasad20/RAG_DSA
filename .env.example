# Copy to .env. An LLM key is only needed for written answers.
# `extract`, `index` and `search` work without any key.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# ...or free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# WHISPER_MODEL=large-v3          # small / medium for faster, less accurate
# WHISPER_LANGUAGE=               # blank = auto-detect, e.g. en, hi
# CHUNK_SECONDS=60
# CHUNK_OVERLAP_SECONDS=15

# Hosted vector database. Leave blank to use the local folder data/qdrant.
QDRANT_URL=
QDRANT_API_KEY=

# Websites allowed to call the answer server, comma separated
# ALLOWED_ORIGINS=https://your-name-your-space.static.hf.space
